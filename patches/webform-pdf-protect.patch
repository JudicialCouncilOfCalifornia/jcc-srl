Delete fillpdf-category webform submissions after the PDF is rendered.

--- a/src/Controller/HandlePdfController.php
+++ b/src/Controller/HandlePdfController.php
@@ -324,6 +324,17 @@
         ->execute();
     }
 
+    // Protect data submitted by user in a webform.
+    // Delete the submission after the pdf is rendered when the webform is in
+    // the "fillpdf" category (Webform 6.x stores categories as an array).
+    if (!empty($context['entity_ids']['webform_submission'])) {
+      $webform_submission_id = array_pop($context['entity_ids']['webform_submission']);
+      $webform_submission = \Drupal\webform\Entity\WebformSubmission::load($webform_submission_id);
+      if ($webform_submission && in_array('fillpdf', $webform_submission->getWebform()->get('categories') ?? [], TRUE)) {
+        $webform_submission->delete();
+      }
+    }
+
     return $response;
   }
 
