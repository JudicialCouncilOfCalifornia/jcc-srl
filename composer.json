{
    "name": "judicialcouncil/jcc-srl",
    "description": "Judicial Council of California Self-Represented Litigant portal - Drupal 8",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "",
            "role": ""
        }
    ],
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "enyo/dropzone": {
            "type": "package",
            "package": {
                "name": "enyo/dropzone",
                "version": "5.5.0",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/enyo/dropzone",
                    "type": "git",
                    "reference": "v5.5.0"
                }
            }
        },
        "judicialcouncilofcalifornia/courtyard": {
            "type": "package",
            "package": {
                "name": "judicialcouncilofcalifornia/courtyard",
                "type": "drupal-library",
                "version": "dev-development",
                "source": {
                    "url": "https://github.com/judicialcouncilofcalifornia/courtyard.git",
                    "type": "git",
                    "reference": "development"
                }
            }
        },
        "components/highlightjs": {
            "type": "package",
            "package": {
                "name": "components/highlightjs",
                "version": "9.7.0",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/components/highlightjs/archive/9.7.0.zip",
                    "type": "zip"
                }
            }
        },
        "d3/d3": {
            "type": "package",
            "package": {
                "name": "d3/d3",
                "version": "v3.5.17",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/d3/d3/archive/v3.5.17.zip",
                    "type": "zip"
                }
            }
        },
        "harvesthq/chosen": {
            "type": "package",
            "package": {
                "name": "harvesthq/chosen",
                "version": "1.8.7",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/harvesthq/chosen/releases/download/v1.8.7/chosen_v1.8.7.zip",
                    "type": "zip"
                },
                "require": {
                    "composer/installers": "^1.2 || ^2"
                }
            }
        }
    },
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^1.7",
        "drupal/access_unpublished": "^1.9",
        "drupal/admin_toolbar": "^3.6",
        "drupal/allowed_formats": "^3.0",
        "drupal/anchor_link": "^3.0",
        "drupal/block_field": "^1.0@RC",
        "drupal/captcha": "^2.0",
        "drupal/chosen": "^5.0",
        "drupal/ckeditor_templates": "^2.0@beta",
        "drupal/classy": "^2.0",
        "drupal/components": "^3.2",
        "drupal/config_ignore": "^3.4",
        "drupal/config_split": "^2.0",
        "drupal/core-composer-scaffold": "^11.4",
        "drupal/core-project-message": "^11.4",
        "drupal/core-recommended": "^11.4",
        "drupal/core-vendor-hardening": "^11.4",
        "drupal/datalayer": "^2.1",
        "drupal/default_content": "^2.0@beta",
        "drupal/devel": "^5.2",
        "drupal/diff": "^2.1",
        "drupal/dropzonejs": "^2.11",
        "drupal/editor_advanced_link": "^2.3",
        "drupal/editoria11y": "^3.0",
        "drupal/entity_browser": "^2.17",
        "drupal/entity_clone": "^2.2@beta",
        "drupal/entity_embed": "^1.7",
        "drupal/environment_indicator": "^4.0",
        "drupal/extlink": "^3.0",
        "drupal/facets": "^3.0",
        "drupal/field_group": "^4.0",
        "drupal/fillpdf": "^5.2",
        "drupal/fixed_block_content": "^1.4",
        "drupal/focal_point": "^2.1",
        "drupal/google_tag": "^2.0",
        "drupal/hal": "^2.0",
        "drupal/honeypot": "^2.2",
        "drupal/inline_entity_form": "^3.0",
        "drupal/insert_view_adv": "^2.0",
        "drupal/jquery_ui_accordion": "^2.1",
        "drupal/jquery_ui_autocomplete": "^2.1",
        "drupal/jquery_ui_button": "^2.1",
        "drupal/jquery_ui_menu": "^2.1",
        "drupal/jsonapi_extras": "^3.28",
        "drupal/key": "^1.23",
        "drupal/link_attributes": "^2.1",
        "drupal/linkit": "^7.0",
        "drupal/login_emailusername": "^3.0",
        "drupal/maillog": "^1.2",
        "drupal/markup": "^2.0",
        "drupal/maxlength": "^3.2",
        "drupal/media_entity_browser": "^3.0",
        "drupal/metatag": "^2.2",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_source_csv": "^3.8",
        "drupal/migrate_tools": "^6.1",
        "drupal/mimemail": "^2.0",
        "drupal/module_filter": "^6.0",
        "drupal/pantheon_advanced_page_cache": "^2.4",
        "drupal/paragraphs": "^1.23",
        "drupal/pathauto": "^1.15",
        "drupal/quicklink": "^3.0",
        "drupal/r4032login": "^2.2",
        "drupal/rabbit_hole": "^1.3",
        "drupal/range": "^1.6",
        "drupal/rebuild_cache_access": "^1.16",
        "drupal/recaptcha": "^3.5",
        "drupal/redirect": "^1.13",
        "drupal/redis": "^1.11",
        "drupal/restui": "^1.22",
        "drupal/robotstxt": "^1.6",
        "drupal/role_delegation": "^1.6",
        "drupal/scheduler": "^2.3",
        "drupal/scheduler_content_moderation_integration": "^3.0",
        "drupal/search_api": "^1.43",
        "drupal/search_api_exclude": "^2.0",
        "drupal/search_api_exclude_entity": "^3.0",
        "drupal/search_api_pantheon": "^8.5",
        "drupal/search_api_solr": "^4.4",
        "drupal/sendgrid_integration": "^2.3",
        "drupal/simple_block": "^1.7",
        "drupal/simple_sitemap": "^4.2",
        "drupal/smart_trim": "^2.3",
        "drupal/stable": "^2.1",
        "drupal/svg_image": "^3.2",
        "drupal/tmgmt": "^1.19",
        "drupal/tmgmt_memsource": "^1.34",
        "drupal/twig_tweak": "^3.4",
        "drupal/upgrade_status": "^4.3",
        "drupal/views_ajax_history": "^1.8",
        "drupal/views_bulk_edit": "^3.0",
        "drupal/views_bulk_operations": "^4.4",
        "drupal/views_data_export": "^1.10",
        "drupal/webform": "^6.3",
        "drupal/webform_rest": "^4.2",
        "drupal/webform_translation_permissions": "^2.1",
        "drupal/workbench": "^1.6",
        "drush/drush": "^13",
        "enyo/dropzone": "^5.5",
        "harvesthq/chosen": "^1.8.7",
        "joachim-n/composer-manifest": "^1.0",
        "judicialcouncil/courtyard-artifact": "^0.1.511",
        "league/csv": "^9.6",
        "oomphinc/composer-installers-extender": "^2.0",
        "phpoffice/phpspreadsheet": "^1.29",
        "vlucas/phpdotenv": "^5"
    },
    "require-dev": {
        "components/highlightjs": "9.7.*",
        "d3/d3": "3.5.*",
        "drupal/log_stdout": "^3.0",
        "drupal/search_kint": "^2.0@beta",
        "drupal/stage_file_proxy": "^4.0",
        "drupal/twig_xdebug": "^1.4"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-vendor-hardening": true,
            "oomphinc/composer-installers-extender": true,
            "joachim-n/composer-manifest": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true
    },
    "autoload": {
        "files": [
            "load.environment.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "find ./vendor/ -type d -name .git | xargs rm -rf",
            "find ./web/ -type d -name .git | xargs rm -rf"
        ],
        "post-update-cmd": [
            "find ./vendor/ -type d -name .git | xargs rm -rf",
            "find ./web/ -type d -name .git | xargs rm -rf"
        ],
        "build-assets": [
            "@prepare-for-pantheon",
            "composer install --optimize-autoloader --no-dev"
        ],
        "lint": "find web/modules/custom web/themes/custom -name '*.php' -exec php -l {} \\;",
        "code-sniff": "echo 'No code sniff step defined.'",
        "unit-test": "echo 'No unit test step defined.'",
        "artifact-sync": [
            "rsync -KPar --delete --force --files-from=scripts/deploy.txt ./ data/artifact/"
        ]
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/core": {
                "Don't override media title with metadata on translation save.": "https://www.drupal.org/files/issues/2019-04-25/media-translation_hassourcefieldchanged-2999370-11.patch",
                "Fix deprecated mb_strtolower": "https://www.drupal.org/files/issues/2023-11-21/3199.patch"
            },
            "drupal/webform": {
                "By default, do not save submissions.": "patches/disable-results-by-default.patch"
            },
            "drupal/fillpdf": {
                "Secure user data after pdf is rendered.": "patches/webform-pdf-protect.patch"
            },
            "drupal/linkit": {
                "Add Webform matcher to fix link creation autocomplete": "https://www.drupal.org/files/issues/2022-07-06/2946234-30.patch"
            },
            "drupal/search_api": {
                "SQL duplicate entry warnings still occurring after v1.30": "https://www.drupal.org/files/issues/2023-11-23/sqlstate-duplicate-entry-warning-when-theres-a-49-symbols-word-3402938-4.patch"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "harvesthq/chosen"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/{$name}": [
                "type:drupal-drush"
            ]
        },
        "drupal-scaffold": {
            "allowed-packages": [
                "pantheon-systems/drupal-integrations"
            ],
            "locations": {
                "web-root": "web/"
            },
            "gitignore": false,
            "file-mapping": {
                "[project-root]/.editorconfig": false,
                "[web-root]/robots.txt": false
            }
        }
    }
}
